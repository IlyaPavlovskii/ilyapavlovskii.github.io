---
const {title, subtitle, desc, companyLink, achievements} = Astro.props;

// Parse subtitle to extract date, company, and location
const parseSubtitle = (subtitle: string) => {
    if (!subtitle) return { date: '', company: '', location: '' };

    // Example format: "From Dec 2023 - Present, at Mapbox, Warsaw, Poland"
    // or "Jul 2022 - Dec 2023, at Elinext, Warsaw, Poland"
    const parts = subtitle.split(', at ');
    const date = parts[0]?.replace('From ', '').trim() || '';
    const locationPart = parts[1] || '';

    // Extract company and location
    const locationMatch = locationPart.match(/^([^,]+),\s*(.+)$/);
    const company = locationMatch ? locationMatch[1].trim() : locationPart;
    const location = locationMatch ? locationMatch[2].trim() : '';

    return { date, company, location };
};

const { date, company, location } = parseSubtitle(subtitle);
---

<div class="flex group">
    <div class="education__time">
        <span class="w-4 h-4 bg-primary block rounded-full mt-1 transition-all duration-300 group-hover:scale-125 group-hover:shadow-lg"></span>
        <span class="education__line bg-primary block h-full w-[2px] translate-x-[7px] transition-all duration-300 group-hover:w-[3px] group-hover:translate-x-[6.5px]"></span>
    </div>
    <div class="experience__data bd-grid px-5 pb-8 transition-all duration-300 group-hover:transform group-hover:translate-x-1">
        <!-- Company Name - Most Prominent -->
        {company && companyLink ? (
            <a href={companyLink} target="_blank" class="block mb-3 group/company">
                <h3 class="text-2xl font-bold text-primary transition-all duration-300 group-hover/company:opacity-80 group-hover/company:underline decoration-2 underline-offset-4">
                    {company}
                </h3>
            </a>
        ) : company ? (
            <h3 class="text-2xl font-bold text-primary mb-3">
                {company}
            </h3>
        ) : null}

        <!-- Date and Location Info -->
        <div class="flex flex-wrap gap-3 mb-3 text-sm">
            {date && (
                <div class="flex items-center gap-1.5 text-gray-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <span class="font-medium">{date}</span>
                </div>
            )}
            {location && (
                <div class="flex items-center gap-1.5 text-gray-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-medium">{location}</span>
                </div>
            )}
        </div>

        <!-- Position Title -->
        <h4 class="text-lg font-semibold mb-3 text-gray-900">
            {title}
        </h4>

        <!-- Company Description -->
        {desc && (
            <div class="my-3 p-4 bg-blue-50 rounded-lg border-l-4 border-primary shadow-sm">
                <p class="text-justify text-gray-800 leading-relaxed">
                    {desc}
                </p>
            </div>
        )}

        <!-- Achievements -->
        {achievements && achievements.length > 0 && (
            <div class="mt-4">
                <h5 class="text-sm font-semibold text-gray-800 mb-3 uppercase tracking-wide">
                    Key Achievements
                </h5>
                <ul class="space-y-2.5">
                    {achievements.map((achievement: string) => (
                        <li class="flex gap-2.5 text-justify">
                            <span class="text-primary mt-1 flex-shrink-0 font-bold">▸</span>
                            <span class="text-gray-700 leading-relaxed" set:html={achievement}></span>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </div>
</div>
