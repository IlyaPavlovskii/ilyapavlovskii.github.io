---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CVBody from "../../../components/cv/CVBody.astro";
import { cvEn } from "../../../data/cv.en";
---

<BaseLayout title="Resume">
    <div class="mb-5 flex items-center justify-between gap-4 flex-wrap">
        <div class="text-3xl font-bold">CV</div>
        <a class="btn btn-primary" href="/CV_Ilia_Pavlovskii.pdf" download="Ilia_Pavlovskii_CV.pdf" target="_blank" rel="noopener">
            Download PDF
        </a>
    </div>

    <div class="mb-10 text-justify">
        Senior Android Engineer with 10+ years of experience architecting high-load mobile and in-car software systems.
        Proven track record delivering 20+ production solutions across consumer apps, fintech platforms, and Android Automotive (AAOS) navigation ecosystems.
        Specialized in Kotlin Multiplatform, Jetpack Compose, modular system design, IPC, and performance optimization on resource-constrained devices.
        Active <a style="color: rgb(0,0,255)" href="https://github.com/IlyaPavlovskii">open-source contributor</a>
        and technical writer on
        <a style="color: rgb(0,0,255)" href="https://habr.com/ru/users/TranE91/">Habr</a> and
        <a style="color: rgb(0,0,255)" href="https://pavlovskiiilia.medium.com/">Medium</a>.
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Education</div>
    </div>

    <div class="time-line-container grid gap-4 mb-10">
        <TimeLineElement
                title="Bachelor's degree, Computer systems and networks"
                company="Belarusian State University of Informatics and Radioelectronics"
                date="2009 - 2014"
                location="Minsk, Belarus"
                color="#1565C0"
                icon="/bsuir.png"
        />
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Experience</div>
    </div>

    <div class="time-line-container mb-10">
        <TimeLineElement
                title="Software Development Engineer II"
                company="Mapbox"
                companyLink="https://mapbox.com/"
                date="Dec 2023 - Present"
                location="Warsaw, Poland"
                color="#000000"
                icon="/mapbox.svg"
                desc="Mapbox — Location data platform powering navigation, mapping, and spatial analytics for mobile, web, and Android Automotive OS across automotive OEMs, logistics, and consumer applications worldwide"
                achievements={[
                    "Engineered the full TTS voice instruction pipeline for turn-by-turn navigation, integrating system TTS services, locale validation, runtime language synchronization, and handling formatting edge cases across CJK and other locales",
                    "Designed and implemented an IPC command framework for an Android Automotive navigation app, delivering 30+ bidirectional commands for routing, camera control, and waypoint lifecycle management with robust handling of large payloads and concurrent command edge cases",
                    "Implemented cross-process AudioFocus coordination covering the full audio interruption matrix between navigation guidance, voice assistants, and other in-car audio consumers",
                    "Designed and delivered a driver distraction mode UI layer compliant with ADAS UX guidelines, restricting map interaction and POI access during active guidance and supported by a simulation tool for emulator and handheld validation",
                    "Implemented multi-screen navigation support across driver and passenger displays with screen-aware UI state and independent event handling per display",
                    "Built voice feedback APIs and Compose UI components for the AI assistant, enabling spoken user feedback collection within navigation sessions",
                    "Led the migration of an in-car AI assistant from multiplatform to native Android, integrating speech recognition (ASR), navigation context, and extracting the UI into a standalone SDK",
                    "Integrated navigation with an aftermarket L2 ADAS device (openpilot/comma2) via a TCP command protocol supporting cruise control speed commands, autopilot state management, and reconnection logic",
                    "Contributed to the Android navigation SDK with APIs for routeline styling, worldview rendering, offline tile localisation fallback, headless navigation samples, and maneuver geometry overrides for OEM partners",
                    "Built a runtime-configurable navigation debug camera system with scenario-based parameters and live state inspection across navigation modes"
                ]}
        />
        <TimeLineElement
            title="Android Software Engineer"
            company="Elinext"
            companyLink="https://www.elinext.com/"
            date="Jul 2022 - Dec 2023"
            location="Warsaw, Poland"
            color="#F00E33"
            icon="/elinext1.png"
            desc="Worked on Arlo Secure – a large-scale smart home security system with multi-device support and complex delivery pipelines. Focused on improving engineering processes, technical stack modernization, and reducing operational costs."
            achievements={[
                "Implemented automated multi-channel distribution pipelines (Firebase App Distribution → Google Play Internal/Alpha tracks) for different build flavors and access levels",
                "Refactored legacy architecture to support modern delivery formats (AAB / Android App Bundles) and streamlined the release process",
                "Introduced unit testing standards and improved tooling, increasing code reliability and reducing regression issues",
                "Mentored engineers during the Java → Kotlin migration, establishing consistent code standards and improving onboarding efficiency"
            ]}
        />
        <TimeLineElement
            title="Android Software Engineer"
            company="Humans Group"
            companyLink="https://apps.humans.uz/"
            date="Jan 2020 - Jul 2022"
            location="Warsaw, Poland"
            color="#F9A825"
            icon="/humans.png"
            desc="Humans.uz is a telecom, banking, and marketplace platform in Uzbekistan. Contributed to the Android application architecture and development process while coordinating technical work across feature teams."
            achievements={[
                "Established a feature-based development workflow with small cross-functional teams (2–4 engineers per feature)",
                "Modularized the Android codebase and introduced binary dependency storage to significantly reduce build times",
                "Introduced a hybrid MVI + MVVM architecture to structure UI state management and feature development",
                "Implemented backend communication based on GraphQL and helped establish a structured workflow for UI design, mobile business logic, and backend integration",
                "Accelerated feature delivery from ~2 months to ~3 weeks while maintaining engineering quality and team efficiency"
            ]}
        />
        <TimeLineElement
            title="Android Software Engineer"
            company="HiQo Solutions"
            companyLink="https://hiqo-solutions.com/"
            date="Jun 2019 - Jan 2020"
            location="Minsk, Belarus"
            color="#D61F26"
            icon="/hiqo-logo.svg"
            desc="HiQo Solutions is a software development company specializing in machine learning, Edge IoT systems, cloud platforms, and advanced software solutions. Contributed to Android projects while supporting engineering processes and team collaboration."
            achievements={[
                "Mentored Android engineers and supported project coordination across development teams",
                "Improved code quality standards and established better engineering practices",
                "Set up and maintained CI/CD pipelines to streamline development and release workflows"
            ]}
        />
        <TimeLineElement
            title="Android Software Engineer"
            company="Yandex"
            companyLink="https://yandex.com/company/"
            date="Jun 2018 - Jun 2019"
            location="Minsk, Belarus"
            color="#FC3F1D"
            icon="/yandex.svg"
            desc="Worked on Yandex Browser, a Chromium-based Android mobile browser. Contributed to UI features, bug fixing, and test automation while supporting the team's transition from Java to Kotlin."
            achievements={[
                "Developed and maintained UI features and fixes in a large Chromium-based Android codebase",
                "Implemented offline Zen feed prefetching, enabling curated news content to be available without internet connectivity",
                "Improved engineering workflows by formalizing and integrating Kotlin lint rules during the team's migration from Java to Kotlin",
                "Contributed to QA automation and feature delivery within a large-scale browser development team"
            ]}
        />
        <TimeLineElement
                title="Android Software Engineer"
                company="Yellow"
                companyLink="https://yellow.systems/"
                date="Jun 2015 - Jun 2018"
                location="Minsk, Belarus"
                color="#F9A825"
                icon="/yellow-systems.svg"
                desc="Yellow is a young and fast growing studio company. My area of responsibility included the development of the company's own projects and the development of custom products. During my work I have successfully delivered all projects to order. In addition, we have had a number of successful projects of our own. And even managed to make some noise at the hackathon."
        />
        <TimeLineElement
                title="Android Software Engineer"
                company="ITM House"
                companyLink="https://www.linkedin.com/company/itm-house/"
                date="Oct 2014 - Jun 2015"
                location="Minsk, Belarus"
                color="#1E88E5"
                desc="ITM House - is a big outsorcing company with a young and fast frowing collective. During my time with the company, I was lucky to start one of the projects that served as a start for the development of the next company - Yellow. This project was FlowerPower."
        />
        <TimeLineElement
                title="Middle Android Developer"
                company="Vega Systems"
                date="Feb 2014 - Sep 2014"
                location="Minsk, Belarus"
                color="#00897B"
                desc="Vega Systems - a young studio company that specialized in small mobile applications. During my work, I managed to release about 7 applications and saturate the market of Belarus and Russia with business solutions."
        />
        <TimeLineElement
                title="Junior Android Developer"
                company="Medical Software Solutions"
                date="Nov 2012 - Feb 2014"
                location="Minsk, Belarus"
                color="#388E3C"
                desc="Medical Software Solutions - is a company specializing in the development of POS for the sale of medical products. It was my first job where I was able to put my knowledge into practice and help the company create prototypes of POS systems."
        />
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Certifications</div>
    </div>

    <ul class="list-disc mx-6 mb-10 grid gap-2">
        <li>
            <a href="/cv/elegion-android.pdf" target="_blank">E-legion & Google. Android Developer school. 2015</a>
        </li>
        <li>CCNA Exploration: Network Fundamentals</li>
        <li>CCNA Exploration: Routing Protocols and Concept</li>
        <li>
            <a href="/cv/mba.pdf" target="_blank">MBA in a Box: Business Lessons from a CEO (Udemy course) 2024</a>
        </li>
    </ul>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Events</div>
    </div>

    <div class="time-line-container mb-10">
        <TimeLineElement
                title="AudioFeed: AI RSS News Briefs & Smart Podcasts"
                company="RevenueCat Shipaton 2026"
                companyLink="https://devpost.com/software/audiofeed-ai-rss-news-briefs-smart-podcasts"
                date="2026"
                location="Online"
                color="#FF5A5F"
                desc="Solo-built mobile app that consolidates multiple RSS feeds on a topic into unified AI-generated audio briefs and smart podcasts. Built with Kotlin Multiplatform (Compose Multiplatform), Supabase, Gemini AI and text-to-speech."
        />
        <TimeLineElement
                title="Geography School education app"
                company="Engineering Jam 3"
                companyLink="https://tech.onliner.by/2019/08/17/jam-2#utm_source=facebook&utm_medium=onliner&utm_campaign=Engineering_Jam_3&utm_term=1st_day&utm_content=article?fbclid=IwAR2wsdgRVEHrHY0cLG6bC7GyyQQUc6dM-E97gFXN0X65o6YSLhtLzLyC8VI"
                date="August 2019"
                location="Minsk, Belarus"
                color="#EF6C00"
                desc="Geography School education app to solve geography quizzes. Participation, no prize"
        />
        <TimeLineElement
                title="Stickerbox"
                company="Skywind Hackaton"
                companyLink="https://www.youtube.com/channel/UCm2fb0ZmA5Hs1FWCEhnx23w"
                date="August 2016"
                location="Minsk, Belarus"
                color="#8E24AA"
                icon="https://www.google.com/s2/favicons?domain=youtube.com&sz=64"
                desc="&quot;Stickerbox&quot; - entertainment application to make custom sticker and send them via android keyboard. Diplomas: &quot;Completed MVP&quot;; &quot;Drive and fun app&quot;; &quot;Selection of the jury&quot;"
        />
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">Skills</div>
    </div>

    <div class="grid gap-2 mx-2 mb-10">
        <div><span class="font-bold">Languages:</span> Kotlin, Java</div>
        <div><span class="font-bold">Core Mobile &amp; Multiplatform:</span> Android SDK, Android Automotive (AAOS), Android Auto, Kotlin Multiplatform (KMP), Compose Multiplatform, Jetpack Compose, Coroutines &amp; Flow</div>
        <div><span class="font-bold">Architecture &amp; Patterns:</span> Clean Architecture, MVI, MVVM, Multi-Module Architecture, IPC, Dependency Injection (Hilt, Dagger)</div>
        <div><span class="font-bold">Data &amp; Networking:</span> Room, SQLite, Retrofit, OkHttp, GraphQL, REST</div>
        <div><span class="font-bold">Automotive &amp; Systems:</span> AudioFocus coordination, ADAS UX guidelines, Mapbox Navigation/Maps SDK, Location/GNSS, Performance Profiling (Perfetto, Android Studio Profiler)</div>
        <div><span class="font-bold">AI Systems:</span> LLM &amp; generative-AI integration (Gemini), speech recognition (ASR) &amp; TTS pipelines, AI-powered product features, AI-assisted development (Claude Code, MCP, agentic workflows)</div>
        <div><span class="font-bold">Tooling &amp; CI/CD:</span> Gradle, GitHub Actions, Bitrise, Firebase</div>
        <div><span class="font-bold">Languages (spoken):</span> English (C1), Polish (C1), Russian (Native)</div>
    </div>
</BaseLayout>
