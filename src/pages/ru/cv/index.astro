            ]}
        />
        <TimeLineElement
                title="Android инженер"
                company="Yellow"
                companyLink="https://yellow.systems/"
                date="Июнь 2015 — Июнь 2018"
                location="Минск, Беларусь"
                color="#F9A825"
                icon="/yellow-systems.svg"
                desc="Yellow — молодая и быстрорастущая компания-студия. За время работы в основном фокусировался на разработке собственных проектов компании, с периодическим переключением на заказные проекты. Все проекты успешно были доставлены заказчику, а также шумно прошли на одном из хакатонов."
        />
        <TimeLineElement
                title="Android инженер"
                company="ITM House"
                companyLink="https://www.linkedin.com/company/itm-house/"
                date="Октябрь 2014 — Июнь 2015"
                location="Минск, Беларусь"
                color="#1E88E5"
                desc="ITM House — большая аутсорсинговая компания с молодым коллективом. Здесь мне довелось начать проект, ставший стартом для следующей компании — Yellow. Проект назывался FlowerPower."
        />
        <TimeLineElement
                title="Middle Android Developer"
